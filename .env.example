# ===========================================
# APPLICATION
# ===========================================
ENVIRONMENT=development
PIPELINE_VERSION=1.0.0
SCHEMA_VERSION=1.0.0

# ===========================================
# DATABASE
# ===========================================
# For Supabase: use the SESSION pooler string (port 5432) for migrations.
# The transaction pooler (port 6543) wraps each statement in its own
# transaction, which breaks DDL such as CREATE INDEX / ALTER TABLE, so
# Alembic must run through the session pooler or the direct connection.
DATABASE_URL=postgresql://user:password@localhost:5432/docextract

# ===========================================
# SUPABASE
# ===========================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# JWT issuer URL (defaults to SUPABASE_URL + /auth/v1 if empty)
JWT_ISSUER=

# ===========================================
# STORAGE
# ===========================================
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=documents

# ===========================================
# MINIO (Local Docker only)
# ===========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents

# ===========================================
# EXTRACTION
# ===========================================
EXTRACTION_MODE=mock
CONFIDENCE_THRESHOLD=0.75

# ===========================================
# OPENAI (Local Docker only)
# ===========================================
OPENAI_API_KEY=
OPENAI_MODEL=
VISION_MAX_PAGES=3
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=3000

# ===========================================
# LIMITS
# ===========================================
MAX_UPLOAD_MB=10
MAX_PAGES=20
RETENTION_DAYS=7
MAX_UPLOADS_PER_DAY=10  # daily upload quota per user (free-tier backstop)

# ===========================================
# CORS
# ===========================================
ALLOWED_ORIGINS=["http://localhost:3000"]

# ===========================================
# WORKER
# ===========================================
WORKER_ENABLED=true
WORKER_POLL_SECONDS=3
MAX_JOB_ATTEMPTS=3

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO_MODE=true